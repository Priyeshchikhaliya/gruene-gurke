# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for metadata, sitemap, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" / "publishable" key — safe to expose, guarded by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key — server only, bypasses RLS. Used by server actions and admin tooling.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Sender. Use onboarding@resend.dev until your domain is verified in Resend.
RESEND_FROM_EMAIL="Grüne Gurke <onboarding@resend.dev>"
# Where reservation requests and contact messages are delivered
RESTAURANT_INBOX_EMAIL=you@example.com
